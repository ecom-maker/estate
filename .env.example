# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_ENV=local

# Database (local Docker Compose)
DATABASE_URL=postgresql://dmproperties:dmproperties@localhost:55432/dmproperties?schema=public
DIRECT_URL=postgresql://dmproperties:dmproperties@localhost:55432/dmproperties?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# Auth.js / NextAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP (mock in local; Twilio-shaped for production)
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OpenAI (optional bootstrap; prefer admin-encrypted key in DB)
OPENAI_API_KEY=

# Application encryption key for API secrets (32-byte hex or base64)
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-media

# Feature flags
AI_ENABLED=true
MOCK_CONNECTORS_ENABLED=true
