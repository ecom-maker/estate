# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local

# --- Database ---
# Option A: local Docker
# DATABASE_URL=postgresql://dmproperties:dmproperties@localhost:55432/dmproperties?schema=public
# DIRECT_URL=postgresql://dmproperties:dmproperties@localhost:55432/dmproperties?schema=public
#
# Option B: Supabase (recommended for Vercel)
# Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6380

AUTH_SECRET=dev-only-change-me
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OTP_PROVIDER=mock
OPENAI_API_KEY=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Supabase API + Storage (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-media

AI_ENABLED=true
MOCK_CONNECTORS_ENABLED=true
