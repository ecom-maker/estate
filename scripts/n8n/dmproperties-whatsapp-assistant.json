{
  "name": "DMProperties WhatsApp Assistant",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "id": "whatsapp-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        -220,
        300
      ],
      "webhookId": "dmproperties-whatsapp",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp Trigger account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-text-only",
              "leftValue": "={{ $json.messages[0].type }}",
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-it-text?",
      "name": "Is It Text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// n8n is only the messenger. It sends the app four things and keeps no state of\n// its own: no chat history, no sessions, no database credentials. The app looks\n// up this sender's history by phone number and saves both sides of the\n// conversation itself.\nconst wa = items[0].json;\nconst msg = wa.messages[0];\n\nreturn [{\n  json: {\n    // The app normalises this to digits, so \"+971 50...\" and \"97150...\" match.\n    phone: msg.from,\n    message: msg.text.body,\n\n    // WhatsApp's own id for this message. The app stores it and refuses to\n    // answer the same id twice, so a webhook WhatsApp retries does not produce\n    // a second reply to the customer.\n    wa_message_id: msg.id,\n\n    // This n8n run. It is written into the whatsapp_logs row, so a failure in\n    // the table can be traced back to the exact execution that caused it.\n    execution_id: $execution.id,\n\n    // Needed to send the reply back; the app never sees it.\n    phone_number_id: wa.metadata.phone_number_id,\n  },\n}];\n"
      },
      "id": "build-request",
      "name": "Build Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://estate-sugg.vercel.app/api/whatsapp/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "REPLACE_WITH_WHATSAPP_WEBHOOK_SECRET"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json",
              "neverError": true
            }
          }
        }
      },
      "id": "ask-the-app",
      "name": "Ask the App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.body.success }}",
              "rightValue": "={{ true }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "did-it-work?",
      "name": "Did It Work?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Build Request').first().json.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('Build Request').first().json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.body.reply }}"
      },
      "id": "send-reply",
      "name": "Send Reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        900,
        100
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Build Request').first().json.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('Build Request').first().json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.body.reply }}"
      },
      "id": "send-sorry-message",
      "name": "Send Sorry Message",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "={{ 'App error: ' + ($('Ask the App').first().json.body.error || 'HTTP ' + $('Ask the App').first().json.statusCode) + ' | log_id: ' + ($('Ask the App').first().json.body.log_id || 'none') }}"
      },
      "id": "mark-execution-failed",
      "name": "Mark Execution Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Voice notes, images, documents and locations reach here. Previously they were\n// dropped and the customer got silence, which reads as the service being broken.\nconst wa = items[0].json;\nconst msg = wa.messages[0];\n\nreturn [{\n  json: {\n    phone: msg.from,\n    phone_number_id: wa.metadata.phone_number_id,\n    reply:\n      \"I can only read text messages at the moment. Please type what you are \" +\n      \"looking for - for example \\\"2 bed in Dubai Marina under 3M\\\".\",\n  },\n}];\n"
      },
      "id": "explain-text-only",
      "name": "Explain Text Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        440
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $json.phone_number_id }}",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.reply }}"
      },
      "id": "send-text-only-notice",
      "name": "Send Text-Only Notice",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        440,
        440
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": {
      "main": [
        [
          {
            "node": "Is It Text?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is It Text?": {
      "main": [
        [
          {
            "node": "Build Request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Explain Text Only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Request": {
      "main": [
        [
          {
            "node": "Ask the App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask the App": {
      "main": [
        [
          {
            "node": "Did It Work?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did It Work?": {
      "main": [
        [
          {
            "node": "Send Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Sorry Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Sorry Message": {
      "main": [
        [
          {
            "node": "Mark Execution Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Explain Text Only": {
      "main": [
        [
          {
            "node": "Send Text-Only Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "description": "WhatsApp -> POST /api/whatsapp/chat -> reply. n8n carries messages only: it holds no chat history and no database credentials, because the app looks up this sender's WhatsApp history by phone number and saves both sides itself. WhatsApp history is kept separate from website chat. The app answers 200 even when it fails, with success:false and the real error, so the customer always gets a sentence while the failure still shows red in n8n and is written to the whatsapp_logs table against this execution id. Before activating: set the two WhatsApp credentials, and replace REPLACE_WITH_WHATSAPP_WEBHOOK_SECRET in 'Ask the App' with the value of WHATSAPP_WEBHOOK_SECRET from the app's environment."
  }
}
