{
  "name": "DMProperties WhatsApp Assistant",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "a1b2c3d4-0001-4a10-9000-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [-120, 300],
      "webhookId": "dmproperties-whatsapp",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp Trigger account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-text-only",
              "leftValue": "={{ $json.messages[0].type }}",
              "rightValue": "text",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4a10-9000-000000000002",
      "name": "Only Text Messages",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://estate-sugg.vercel.app/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: [ { role: 'user', content: $json.messages[0].text.body } ] }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 30000
        }
      },
      "id": "a1b2c3d4-0003-4a10-9000-000000000003",
      "name": "Ask Property Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('WhatsApp Trigger').item.json.metadata.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('WhatsApp Trigger').item.json.messages[0].from }}",
        "messageType": "text",
        "textBody": "={{ $json.data }}"
      },
      "id": "a1b2c3d4-0004-4a10-9000-000000000004",
      "name": "Reply on WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [600, 300],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": {
      "main": [[{ "node": "Only Text Messages", "type": "main", "index": 0 }]]
    },
    "Only Text Messages": {
      "main": [[{ "node": "Ask Property Database", "type": "main", "index": 0 }]]
    },
    "Ask Property Database": {
      "main": [[{ "node": "Reply on WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "meta": {
    "description": "Incoming WhatsApp message -> POST /api/chat (DMProperties conversational search) -> reply with the structured answer. Uses Meta WhatsApp Business Cloud."
  }
}
